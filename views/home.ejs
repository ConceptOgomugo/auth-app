<%- include('partials/header') %>

<nav class="navbar navbar-expand-md  fixed-top  panhead"> 
    <div class="container-fluid"> 
        <img class="navlogo" src= "/images/Pan Travels nav bar.png" alt="Pan Travels Logo">
        <div class="collapse navbar-collapse" id="navbarCollapse"> 
        </div> 
    </div> 
</nav>

<div class="container col-xl-10 col-xxl-8 px-4 py-5"> 
  <div class="row align-items-center g-lg-5 py-5"> 
    <div class="col-lg-7 text-center text-lg-start"> 
      <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3"><img class="logo" src= "/images/Pan Travels.png" alt="Pan Travels Logo"></h1> 
      <p class="col-lg-10 fs-4 admintext">AVAILABLE ONLY FOR ADMINISTRATION USE</p> 
    </div> 
    <div class="col-md-10 mx-auto col-lg-5"> 
      <form method="POST" class="p-4 p-md-5 border rounded-3 bg-body-tertiary"> 
        <div class="form-floating mb-3"> 
          <input type="email" class="form-control" id="floatingInput" placeholder="name@example.com" name="username"> 
          <label for="floatingInput email">Email address</label> 
        </div> 
        <div class="form-floating mb-3"> 
          <input type="password" class="form-control" id="floatingPassword" placeholder="Password" name="password"> 
          <label for="floatingPassword password">Password</label> 
        </div> 
        <div class="checkbox mb-3"> 
        </div> 
        <div class="d-flex">
            <button formaction= "/login" class="w-100 btn btn-lg btn-primary lbutton" type="submit">Log In</button> 
            <button formaction= "/register" class="w-100 btn btn-lg btn-primary ms-3" type="submit">Register</button> 
        </div> 
      </form> 
    </div> 
  </div> 
</div>

<%- include('partials/footer') %>